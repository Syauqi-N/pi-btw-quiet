{
  "name": "pi-btw-quiet",
  "version": "0.3.0",
  "description": "Ask a side question in Pi without disturbing the running agent. A read-only side agent that can inspect your repo, in a panel that never takes your keyboard.",
  "type": "module",
  "license": "MIT",
  "author": "Syauqi-N",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "btw",
    "side-question",
    "read-only-agent"
  ],
  "pi": {
    "extensions": [
      "./extensions/btw.ts"
    ]
  },
  "files": [
    "extensions/**/*.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "assets"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syauqi-N/pi-btw-quiet.git"
  },
  "bugs": {
    "url": "https://github.com/Syauqi-N/pi-btw-quiet/issues"
  },
  "homepage": "https://github.com/Syauqi-N/pi-btw-quiet#readme"
}
